# ─────────────────────────────────────────────────────────────
# Database (Postgres en port 5435 — 5433/5434 ya ocupados por otros proyectos)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://condominios:condominios_dev@localhost:5435/condominios?schema=public"

# ─────────────────────────────────────────────────────────────
# Redis (port 6380 para evitar choque con Redis de otros proyectos)
# ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ─────────────────────────────────────────────────────────────
# NextAuth / Auth.js
# Generar secret con: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3010"
NEXTAUTH_SECRET="cambiar-por-secret-real-de-32-bytes"

# ─────────────────────────────────────────────────────────────
# Email (magic links NextAuth + envío de facturas/notificaciones)
# Sin SMTP_HOST configurado → dry-run (solo logs). Funciona con Gmail, Brevo, Mailgun, etc.
# ─────────────────────────────────────────────────────────────
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@condominios.app"

# SMTP para facturas y notificaciones (puede ser el mismo que arriba)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Condominios <noreply@tudominio.com>"

# ─────────────────────────────────────────────────────────────
# MinIO / S3 (documentos, fotos)
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9100"
S3_REGION="us-east-1"
S3_ACCESS_KEY="condominios"
S3_SECRET_KEY="condominios_dev"
S3_BUCKET="condominios-dev"
S3_FORCE_PATH_STYLE="true"

# ─────────────────────────────────────────────────────────────
# Tasas de cambio Venezuela (Fase 2)
# ─────────────────────────────────────────────────────────────
BCV_API_URL="https://www.bcv.org.ve/api/excambiario"
BINANCE_P2P_API_URL="https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search"

# ─────────────────────────────────────────────────────────────
# WhatsApp (Fase 4)
# ─────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER="WATI"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────
# Bootstrap
# Email del primer PLATFORM_OWNER (creado por seed)
# ─────────────────────────────────────────────────────────────
PLATFORM_OWNER_EMAIL="admin@condominios.local"
